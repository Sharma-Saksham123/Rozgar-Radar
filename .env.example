# ---------------------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# LLM — any OpenAI-compatible chat completions endpoint
# ---------------------------------------------------------------------------
LLM_API_KEY=your-llm-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Resend — email delivery for daily alerts
# ---------------------------------------------------------------------------
RESEND_API_KEY=your-resend-key
EMAIL_FROM=Rozgar Radar <alerts@yourdomain.com>

# ---------------------------------------------------------------------------
# Cron — sent as the Authorization header by the daily job
# ---------------------------------------------------------------------------
CRON_SECRET=your-random-cron-secret

# Public URL of this deployment, used for links inside the alert email
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# HirePulse Engine — Multi-Source Job Aggregation Backend (FastAPI)
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./jobs.db
ADMIN_API_KEY=change-this-secure-admin-key-in-production
SYNC_INTERVAL_HOURS=24
SYNC_TIMEOUT_SECONDS=60
MAX_RETRIES_PER_SOURCE=3
RETRY_BACKOFF_FACTOR=2.0
RATE_LIMIT_DELAY_SECONDS=1.0

# HirePulse Frontend API URL
NEXT_PUBLIC_HIREPULSE_API_URL=http://localhost:8000/api/v1
